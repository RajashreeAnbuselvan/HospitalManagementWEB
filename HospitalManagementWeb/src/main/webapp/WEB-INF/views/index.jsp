<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>CarePoint | Hospital Management</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="brand"><span class="brand-icon">✚</span><div><b>CarePoint</b><small>HOSPITAL MANAGEMENT</small></div></div>
<nav><a class="${page=='dashboard'?'active':''}" href="?page=dashboard">▦ &nbsp; Dashboard</a><a class="${page=='patients'?'active':''}" href="?page=patients">♙ &nbsp; Patients</a><a class="${page=='doctors'?'active':''}" href="?page=doctors">⚕ &nbsp; Doctors</a><a class="${page=='appointments'?'active':''}" href="?page=appointments">▣ &nbsp; Appointments</a><a class="${page=='prescriptions'?'active':''}" href="?page=prescriptions">☷ &nbsp; Prescriptions</a><a class="${page=='billing'?'active':''}" href="?page=billing">₹ &nbsp; Billing</a></nav>
<div class="sidebar-bottom"><span class="pulse"></span> System online<small>Java · JSP · H2 Database</small></div></aside>
<main class="main"><header class="topbar"><div><span class="eyebrow">HOSPITAL OPERATIONS</span><h1><c:choose><c:when test="${page=='patients'}">Patient Management</c:when><c:when test="${page=='doctors'}">Doctor Management</c:when><c:when test="${page=='appointments'}">Appointment Booking</c:when><c:when test="${page=='prescriptions'}">Prescriptions & Diagnosis</c:when><c:when test="${page=='billing'}">Billing Management</c:when><c:otherwise>Dashboard Overview</c:otherwise></c:choose></h1></div><div class="user"><div class="avatar">CP</div><div><b>Administrator</b><small>Hospital staff</small></div></div></header>
<c:if test="${page=='dashboard' || page==null}"><section class="welcome"><div><span class="eyebrow light">CAREPOINT ADMINISTRATION</span><h2>Good day. Here's your hospital at a glance.</h2><p>Manage patients, doctors, appointments, prescriptions and billing in one place.</p></div><div class="welcome-icon">✚</div></section>
<div class="stats"><div class="stat"><div class="stat-top"><span>Total patients</span><span class="stat-icon blue">♙</span></div><strong>${patientCount}</strong><small>Registered patients</small></div><div class="stat"><div class="stat-top"><span>Medical staff</span><span class="stat-icon green">⚕</span></div><strong>${doctorCount}</strong><small>Registered doctors</small></div><div class="stat"><div class="stat-top"><span>Appointments</span><span class="stat-icon purple">▣</span></div><strong>${appointmentCount}</strong><small>All scheduled records</small></div><div class="stat"><div class="stat-top"><span>Pending bills</span><span class="stat-icon orange">₹</span></div><strong>${unpaidCount}</strong><small>Awaiting payment</small></div></div>
<div class="section-head"><div><h2>Quick actions</h2><p>Start a common task</p></div></div><div class="quick-grid"><a class="quick" href="?page=patients"><span class="quick-icon blue">＋</span><b>Register patient</b><small>Add a patient record</small><span class="arrow">↗</span></a><a class="quick" href="?page=doctors"><span class="quick-icon green">＋</span><b>Add doctor</b><small>Register medical staff</small><span class="arrow">↗</span></a><a class="quick" href="?page=appointments"><span class="quick-icon purple">▣</span><b>Book appointment</b><small>Schedule a consultation</small><span class="arrow">↗</span></a><a class="quick" href="?page=billing"><span class="quick-icon orange">₹</span><b>Create bill</b><small>Manage patient billing</small><span class="arrow">↗</span></a></div>
<div class="section-head"><div><h2>Recent appointments</h2><p>Latest scheduled visits</p></div><a class="text-link" href="?page=appointments">View all →</a></div><div class="panel"><div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Status</th></tr></thead><tbody><c:forEach items="${appointments}" var="a" begin="0" end="4"><tr><td><b><c:out value="${a.patient_name}"/></b></td><td><c:out value="${a.doctor_name}"/></td><td><c:out value="${a.appointment_date}"/></td><td><c:out value="${a.appointment_time}"/></td><td><span class="pill"><c:out value="${a.status}"/></span></td></tr></c:forEach><c:if test="${empty appointments}"><tr><td colspan="5" class="empty">No appointments yet. Book one from the Appointments page.</td></tr></c:if></tbody></table></div></div></c:if>
<c:if test="${page=='patients'}"><div class="two-col"><section class="panel form-panel"><h2>Register patient</h2><p class="muted">Enter patient details below.</p><form method="post"><input type="hidden" name="action" value="addPatient"><input type="hidden" name="returnPage" value="patients"><label>Full name *</label><input name="name" required maxlength="120"><div class="form-row"><div><label>Age</label><input type="number" name="age" min="0" max="125"></div><div><label>Gender</label><select name="gender"><option>Prefer not to say</option><option>Female</option><option>Male</option><option>Other</option></select></div></div><label>Phone</label><input name="phone"><label>Email</label><input type="email" name="email"><label>Medical history / notes</label><textarea name="medical_history" rows="3"></textarea><button class="btn">Save patient</button></form></section><section class="panel"><div class="panel-head"><div><h2>Patient directory</h2><p class="muted">${patients.size()} records shown</p></div><form class="search" method="get"><input type="hidden" name="page" value="patients"><input name="q" value="<c:out value='${q}'/>" placeholder="Search name or phone"><button class="btn secondary">Search</button></form></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Patient</th><th>Age / Gender</th><th>Phone</th><th>Email</th></tr></thead><tbody><c:forEach items="${patients}" var="p"><tr><td>#${p.id}</td><td><b><c:out value="${p.name}"/></b><small class="cell-sub"><c:out value="${p.medical_history}"/></small></td><td><c:out value="${p.age}"/> / <c:out value="${p.gender}"/></td><td><c:out value="${p.phone}"/></td><td><c:out value="${p.email}"/></td></tr></c:forEach><c:if test="${empty patients}"><tr><td colspan="5" class="empty">No patient records found.</td></tr></c:if></tbody></table></div></section></div></c:if>
<c:if test="${page=='doctors'}"><div class="two-col"><section class="panel form-panel"><h2>Register doctor</h2><p class="muted">Add a doctor to the directory.</p><form method="post"><input type="hidden" name="action" value="addDoctor"><input type="hidden" name="returnPage" value="doctors"><label>Full name *</label><input name="name" required><label>Specialization</label><input name="specialization" placeholder="e.g. Cardiology"><label>Phone</label><input name="phone"><label>Email</label><input type="email" name="email"><button class="btn">Save doctor</button></form></section><section class="panel"><div class="panel-head"><h2>Doctor directory</h2><form class="search" method="get"><input type="hidden" name="page" value="doctors"><input name="q" value="<c:out value='${q}'/>" placeholder="Search doctors"><button class="btn secondary">Search</button></form></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Doctor</th><th>Specialization</th><th>Phone</th><th>Email</th></tr></thead><tbody><c:forEach items="${doctors}" var="d"><tr><td>#${d.id}</td><td><b><c:out value="${d.name}"/></b></td><td><span class="pill green-pill"><c:out value="${d.specialization}"/></span></td><td><c:out value="${d.phone}"/></td><td><c:out value="${d.email}"/></td></tr></c:forEach></tbody></table></div></section></div></c:if>
<c:if test="${page=='appointments'}"><div class="two-col"><section class="panel form-panel"><h2>Book appointment</h2><p class="muted">Choose a patient and available doctor.</p><form method="post"><input type="hidden" name="action" value="addAppointment"><input type="hidden" name="returnPage" value="appointments"><label>Patient ID *</label><input name="patient_id" type="number" min="1" required placeholder="See patient directory"><label>Doctor ID *</label><input name="doctor_id" type="number" min="1" required placeholder="See doctor directory"><div class="form-row"><div><label>Date *</label><input name="appointment_date" type="date" required></div><div><label>Time *</label><input name="appointment_time" type="time" required></div></div><label>Reason for visit</label><textarea name="reason" rows="3"></textarea><button class="btn">Book appointment</button><small class="hint">Use IDs from the Patients and Doctors tables.</small></form></section><section class="panel"><h2 class="panel-title">Appointment schedule</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Patient</th><th>Doctor</th><th>Date / time</th><th>Reason</th><th>Status</th></tr></thead><tbody><c:forEach items="${appointments}" var="a"><tr><td>#${a.id}</td><td><c:out value="${a.patient_name}"/></td><td><c:out value="${a.doctor_name}"/></td><td><c:out value="${a.appointment_date}"/><small class="cell-sub"><c:out value="${a.appointment_time}"/></small></td><td><c:out value="${a.reason}"/></td><td><span class="pill"><c:out value="${a.status}"/></span></td></tr></c:forEach><c:if test="${empty appointments}"><tr><td colspan="6" class="empty">No appointments booked.</td></tr></c:if></tbody></table></div></section></div></c:if>
<c:if test="${page=='prescriptions'}"><div class="two-col"><section class="panel form-panel"><h2>Diagnosis & prescription</h2><p class="muted">Record treatment for an appointment.</p><form method="post"><input type="hidden" name="action" value="addPrescription"><input type="hidden" name="returnPage" value="prescriptions"><label>Appointment ID *</label><input type="number" name="appointment_id" min="1" required><label>Diagnosis *</label><textarea name="diagnosis" rows="2" required></textarea><label>Medicines / dosage</label><textarea name="medicines" rows="3"></textarea><label>Additional notes</label><textarea name="notes" rows="2"></textarea><button class="btn">Save prescription</button></form></section><section class="panel"><h2 class="panel-title">Prescription records</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Patient / doctor</th><th>Diagnosis</th><th>Medicines</th><th>Notes</th></tr></thead><tbody><c:forEach items="${prescriptions}" var="p"><tr><td>#${p.id}</td><td><b><c:out value="${p.patient_name}"/></b><small class="cell-sub"><c:out value="${p.doctor_name}"/></small></td><td><c:out value="${p.diagnosis}"/></td><td><c:out value="${p.medicines}"/></td><td><c:out value="${p.notes}"/></td></tr></c:forEach><c:if test="${empty prescriptions}"><tr><td colspan="5" class="empty">No prescriptions recorded.</td></tr></c:if></tbody></table></div></section></div></c:if>
<c:if test="${page=='billing'}"><div class="two-col"><section class="panel form-panel"><h2>Generate bill</h2><p class="muted">Create a bill linked to a patient.</p><form method="post"><input type="hidden" name="action" value="addBill"><input type="hidden" name="returnPage" value="billing"><label>Patient ID *</label><input type="number" name="patient_id" min="1" required><label>Appointment ID</label><input type="number" name="appointment_id" min="1"><label>Amount (₹) *</label><input type="number" name="amount" min="0" step="0.01" required><label>Description</label><textarea name="description" rows="3"></textarea><button class="btn">Generate bill</button></form></section><section class="panel"><h2 class="panel-title">Billing records</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Patient</th><th>Description</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${bills}" var="b"><tr><td>#${b.id}</td><td><c:out value="${b.patient_name}"/></td><td><c:out value="${b.description}"/></td><td><b>₹ <c:out value="${b.amount}"/></b></td><td><c:choose><c:when test="${b.paid}"><span class="pill green-pill">Paid</span></c:when><c:otherwise><span class="pill red-pill">Pending</span></c:otherwise></c:choose></td><td><c:if test="${not b.paid}"><form method="post" class="inline-form"><input type="hidden" name="action" value="payBill"><input type="hidden" name="returnPage" value="billing"><input type="hidden" name="id" value="${b.id}"><button class="btn small-btn">Mark paid</button></form></c:if></td></tr></c:forEach><c:if test="${empty bills}"><tr><td colspan="6" class="empty">No bills generated.</td></tr></c:if></tbody></table></div></section></div></c:if>
<footer>CarePoint Hospital Management System <span>Java · JSP · JDBC · H2</span></footer></main></div></body></html>